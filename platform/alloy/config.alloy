logging {
  level = "info"
}

// Reuse the course's application and database scrape definitions.
prometheus.operator.servicemonitors "application" {
  namespaces = ["food-delivery"]
  forward_to = [prometheus.remote_write.cloud.receiver]
}

prometheus.operator.podmonitors "database" {
  namespaces = ["food-delivery"]
  forward_to = [prometheus.remote_write.cloud.receiver]
}

prometheus.operator.servicemonitors "objects" {
  namespaces = ["monitoring"]
  selector {
    match_labels = {"app.kubernetes.io/name" = "kube-state-metrics"}
  }
  forward_to = [prometheus.relabel.course.receiver]
}

// Only this trusted course monitor references the mounted service-account files.
prometheus.operator.servicemonitors "kubelet" {
  namespaces = ["monitoring"]
  allow_arbitrary_file_access = true
  selector {
    match_labels = {"app" = "kube-prometheus-stack-kubelet"}
  }
  forward_to = [prometheus.relabel.course.receiver]
}

// Limit infrastructure series to the two course namespaces.
prometheus.relabel "course" {
  rule {
    source_labels = ["namespace"]
    regex = "food-delivery|betrieb-lab"
    action = "keep"
  }
  forward_to = [prometheus.remote_write.cloud.receiver]
}

prometheus.remote_write "cloud" {
  external_labels = {cluster = "teko-k8s"}
  endpoint {
    url = sys.env("GC_METRICS_URL")
    basic_auth {
      username = sys.env("GC_METRICS_USER")
      password = sys.env("GC_TOKEN")
    }
  }
}

discovery.kubernetes "pods" {
  role = "pod"
  namespaces {
    names = ["food-delivery", "betrieb-lab"]
  }
}

discovery.relabel "pod_logs" {
  targets = discovery.kubernetes.pods.targets
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label = "container"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_container_name"]
    separator = "/"
    target_label = "job"
  }
}

loki.source.kubernetes "pods" {
  targets = discovery.relabel.pod_logs.output
  forward_to = [loki.write.cloud.receiver]
}

loki.source.kubernetes_events "course" {
  namespaces = ["food-delivery", "betrieb-lab"]
  job_name = "kubernetes-events"
  log_format = "json"
  forward_to = [loki.write.cloud.receiver]
}

loki.write "cloud" {
  external_labels = {cluster = "teko-k8s"}
  endpoint {
    url = sys.env("GC_LOGS_URL")
    basic_auth {
      username = sys.env("GC_LOGS_USER")
      password = sys.env("GC_TOKEN")
    }
  }
}
