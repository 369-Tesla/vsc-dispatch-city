{
  "title": "Dispatch City - Infrastruktur (Cloud)",
  "uid": "dispatch-city-infra-cloud",
  "description": "Ergänzende Betriebsmetriken aus der bestehenden Alloy-Auswahl.",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "dispatch-city"
  ],
  "links": [
    {
      "title": "Dispatch City - Betrieb",
      "type": "link",
      "url": "/d/dispatch-city-cloud/dispatch-city-betrieb-cloud",
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Container nicht bereit",
      "description": "Nicht bereite Container in beiden Kurs-Namespaces. Fehlende Metriken bleiben als No data sichtbar.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(1 - max by (namespace,pod,container) (kube_pod_container_status_ready{cluster=\"teko-k8s\",namespace=~\"food-delivery|betrieb-lab\"}))",
          "refId": "A",
          "legendFormat": "Container",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
